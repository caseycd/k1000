{
  "name": "k1000-interactive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "K1000 Interactive \u2014 an explorable digital-twin visualization of the K1000 drone.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
